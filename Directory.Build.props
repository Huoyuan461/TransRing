<!--
  Shared MSBuild settings for every project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler; documenting only the non-obvious
         parameters of a member is fine (CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>1.0.0</Version>
    <Product>TransRing</Product>
    <Authors>TransRing</Authors>
    <Copyright>Copyright (c) 2026 TransRing</Copyright>

    <!-- Free edition switch: build with `-p:TransRingFree=true` and every project in this tree
         compiles with TRANSRING_FREE (see TransRing.Core.Formats.Edition). Without it the build is
         the full paid edition. Kept here, not in a single project, so Core and its consumers can
         never disagree about the edition (a const would be inlined per assembly). -->
    <DefineConstants Condition="'$(TransRingFree)' == 'true'">$(DefineConstants);TRANSRING_FREE</DefineConstants>

    <!-- Single source of truth for the GitHub repository (used by the updater and the About page). -->
    <TransRingRepositoryUrl>https://github.com/Huoyuan461/TransRing</TransRingRepositoryUrl>
    <RepositoryUrl>$(TransRingRepositoryUrl)</RepositoryUrl>
  </PropertyGroup>
</Project>

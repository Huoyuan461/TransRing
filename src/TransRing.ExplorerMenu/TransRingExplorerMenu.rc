// Version information of the Explorer context-menu DLL. build/build-explorer-menu.ps1 passes the app version as
// TRANSRING_VERSION_MAJOR/MINOR/PATCH and TRANSRING_VERSION_TEXT.

#include <winver.h>

#ifndef TRANSRING_VERSION_MAJOR
#define TRANSRING_VERSION_MAJOR 0
#define TRANSRING_VERSION_MINOR 0
#define TRANSRING_VERSION_PATCH 0
#define TRANSRING_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION TRANSRING_VERSION_MAJOR, TRANSRING_VERSION_MINOR, TRANSRING_VERSION_PATCH, 0
PRODUCTVERSION TRANSRING_VERSION_MAJOR, TRANSRING_VERSION_MINOR, TRANSRING_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "TransRing contributors"
            VALUE "FileDescription", "TransRing File Explorer context menu"
            VALUE "FileVersion", TRANSRING_VERSION_TEXT
            VALUE "InternalName", "TransRingExplorerMenu"
            VALUE "LegalCopyright", "Copyright (c) TransRing contributors. MIT License."
            VALUE "OriginalFilename", "TransRingExplorerMenu.dll"
            VALUE "ProductName", "TransRing"
            VALUE "ProductVersion", TRANSRING_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
